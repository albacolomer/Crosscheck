PORT=3001
CLIENT_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
TAVILY_API_KEY=
# Optional: OpenAI model for claim extraction and evidence analysis (default gpt-5.4-mini).
OPENAI_ANALYSIS_MODEL=
# Optional: OpenAI Decisions model for the checkability gate (default gpt-6-luna; "none" disables the gate).
OPENAI_DECISIONS_MODEL=
# Optional: pipeline module path (default ./server/services/factCheckPipeline.ts; "none" disables analysis).
AI_PIPELINE_MODULE=
# Optional: "off" disables speaker labels (gpt-4o-transcribe-diarize on each finished turn; default on).
SPEAKER_DIARIZATION=
